# Tidak ada apa pun di sini yang boleh dilayani lewat HTTP.
#
# Direktori ini berisi .env, kunci OAuth, storage/app/private (pindaian KTM,
# kartu keluarga, surat keterangan sehat), dan seluruh kode aplikasi. Ia berada
# di dalam document root hanya karena pola hosting bersama tidak selalu
# mengizinkan document root diarahkan ke subfolder.
#
# Penolakan ini digandakan di .htaccess root. Yang di sini adalah lapis yang
# tetap berlaku ketika mod_rewrite tidak aktif.

<IfModule mod_authz_core.c>
    # Apache 2.4
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
