APP_NAME="Open Academic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Mesin basis data adalah pilihan konfigurasi, bukan keputusan yang tertanam di
# kode: seluruh akses data lewat Eloquent. Ganti ke PostgreSQL cukup dengan
# DB_CONNECTION=pgsql dan DB_PORT=5432.
#
# Didukung: mysql · pgsql · sqlite. Oracle butuh paket pihak ketiga —
# baca docs/BASIS-DATA.md sebelum merencanakannya.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=open_academic
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Set SESSION_SECURE_COOKIE=true on any installation served over HTTPS —
# without it the session cookie is sent over plain HTTP too, which is all an
# attacker on the same campus wifi needs to take over a staff account.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Batas percobaan masuk yang gagal, di atas batas per identitas + alamat:
# per akun dari alamat mana pun (per 15 menit), dan per alamat ke akun mana pun
# (per 5 menit). Naikkan per alamat bila seluruh kampus keluar lewat satu NAT.
AUTH_BATAS_PER_AKUN=20
AUTH_BATAS_PER_ALAMAT=50

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@open-academic.test"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Notifikasi
#--------------------------------------------------------------------------
#
# Notifikasi memerlukan worker antrean yang menyala:
#
#   php artisan queue:work --tries=3
#
# dan pengingat tenggat memerlukan satu entri cron:
#
#   * * * * * cd /path/ke/aplikasi && php artisan schedule:run >> /dev/null 2>&1
#
# Tanpa keduanya tidak ada yang terkirim, dan tidak ada yang memberi tahu bahwa
# demikian. Lihat docs/NOTIFIKASI.md.
#
# WhatsApp mati secara bawaan dan tidak menyertakan adaptor penyedia mana pun.
# Menyalakannya perlu dua hal terpisah: driver, dan daftar kategori yang boleh
# lewat. Nama driver yang tidak dikenal akan menggagalkan boot — bukan diam-diam
# berhenti mengirim.

NOTIFIKASI_WHATSAPP_DRIVER=nonaktif
NOTIFIKASI_WHATSAPP_PENGIRIM=
NOTIFIKASI_WHATSAPP_KATEGORI=

#--------------------------------------------------------------------------
# Surat & Verifikasi Dokumen
#--------------------------------------------------------------------------
#
# TETAPKAN POLA NOMOR SEBELUM SURAT PERTAMA TERBIT. Mengubahnya setelah itu
# berarti dua konvensi hidup berdampingan di lemari arsip yang sama.
#
# Placeholder: {urut} {kode} {bulan} (Romawi) {tahun} {institusi}
#
# Nama penandatangan boleh dikosongkan — yang tercetak lalu hanya nama
# institusi, dan itu lebih baik daripada nama pejabat yang sudah tidak
# menjabat.
#
# SURAT_TAHAN_BILA_MENUNGGAK hanya menghitung tagihan yang SUDAH LEWAT jatuh
# tempo. Lihat docs/SURAT.md.

SURAT_POLA_NOMOR="{urut}/{kode}/{institusi}/{bulan}/{tahun}"
SURAT_PENANDATANGAN_NAMA=
SURAT_PENANDATANGAN_JABATAN="Kepala Biro Administrasi Akademik"
SURAT_PENANDATANGAN_NIP=
SURAT_TAHAN_BILA_MENUNGGAK=false
SURAT_VERIFIKASI_AKTIF=true
SURAT_VERIFIKASI_BATAS=10

#--------------------------------------------------------------------------
# Helpdesk
#--------------------------------------------------------------------------
#
# Nomor tiket disebut lewat telepon dan ditulis di subjek surel; pendek lebih
# penting daripada memuat banyak kode. SLA bawaan dipakai bila kategori tidak
# menetapkan jamnya sendiri; penjadwal hanya MENANDAI tiket yang lewat tenggat,
# tidak pernah menutupnya. Lihat docs/HELPDESK.md.

HELPDESK_POLA_NOMOR="HD-{tahun}-{urut}"
HELPDESK_SLA_JAM=72

#--------------------------------------------------------------------------
# Konversi Kredit (Transfer & RPL)
#--------------------------------------------------------------------------
#
# ACADEMIC_KONVERSI_HITUNG_IPK — apakah nilai yang dikonversi ikut menghitung
# IPK. Mati secara bawaan, dan itu posisi bukan ketidakpedulian: IPK adalah
# penilaian institusi ini, sedangkan nilai konversi diberikan pihak lain dengan
# standar lain. Kreditnya selalu masuk total SKS apa pun setelannya.
#
# ACADEMIC_KONVERSI_MAKS_PERSEN — batas pengakuan terhadap syarat kelulusan
# prodi. Tanpa batas, seseorang dapat diakui masuk ke dalam gelar. Tetapkan
# angkanya secara sadar.

ACADEMIC_KONVERSI_HITUNG_IPK=false
ACADEMIC_KONVERSI_MAKS_PERSEN=50

#--------------------------------------------------------------------------
# Mahasiswa Pindahan & RPL
#--------------------------------------------------------------------------
#
# ACADEMIC_PINDAHAN_SKS_PER_SEMESTER — berapa SKS diakui yang dihitung sebagai
# satu semester yang sudah ditempuh. Semester masuk = 1 + floor(SKS diakui /
# angka ini); 40 SKS diakui dengan bawaan 20 menempatkan mahasiswa di semester 3.
#
# ACADEMIC_PINDAHAN_MASA_STUDI_DARI_ASAL — apakah batas masa studi ikut
# menghitung semester di perguruan tinggi asal (dari "semester masuk asal").
# Mati secara bawaan: batas itu aturan kampus ini tentang studi di sini.

ACADEMIC_PINDAHAN_SKS_PER_SEMESTER=20
ACADEMIC_PINDAHAN_MASA_STUDI_DARI_ASAL=false

#--------------------------------------------------------------------------
# Keringanan & Beasiswa
#--------------------------------------------------------------------------
#
# Tidak ada setelan environment. Skema beasiswa, cakupan, dan kuotanya dibuat
# lewat layar Beasiswa & Keringanan — itu keputusan kampus, bukan konfigurasi
# deployment.
#
# Yang perlu diketahui operator: potongan adalah baris bernilai negatif pada
# tagihan, sehingga tagihan.total selalu sama dengan jumlah barisnya dan selalu
# merupakan jumlah yang benar-benar harus dibayar. Jangan menambahkan potongan
# lewat SQL langsung tanpa menghitung ulang total dan status pembayarannya.

#--------------------------------------------------------------------------
# Institution branding (per-tenant white label)
#--------------------------------------------------------------------------
BRAND_INSTITUTION_NAME="Universitas Nusantara Digital"
BRAND_INSTITUTION_SHORT="UND"
BRAND_INSTITUTION_CODE="001001"
BRAND_LOGO_PATH=
BRAND_PRIMARY_COLOR="#1E2761"
BRAND_ACCENT_COLOR="#C9A961"

#--------------------------------------------------------------------------
# Academic defaults
#--------------------------------------------------------------------------
ACADEMIC_ACTIVE_TERM=20261
ACADEMIC_MEETINGS_PER_TERM=16
ACADEMIC_MIN_ATTENDANCE_PERCENT=75
ACADEMIC_KRS_REQUIRES_PAYMENT=true
ACADEMIC_KRS_MIN_PAYMENT_PERCENT=50

# Dari mana nomor ijazah berasal: "pisn" (bawaan) berarti dicatat dari nomor
# yang diterbitkan Penomoran Ijazah dan Sertifikat Profesi Nasional (PISN)
# sesudah data lulusan di PDDIKTI lolos validator, dan dapat diverifikasi publik
# di laman PISN; "lokal" berarti dibangkitkan dari pola di bawah — hanya untuk
# institusi di luar skema nasional. Ijazah bernomor lokal tercetak rapi dan
# gagal saat diperiksa pemberi kerja bertahun-tahun kemudian. Nilai lama "pin"
# masih dibaca sebagai "pisn" tetapi usang (ADR-036 §2). Angka validator PISN
# ada di config/academic.php → ijazah.pisn.
ACADEMIC_IJAZAH_SUMBER=pisn
ACADEMIC_IJAZAH_PATTERN="{tahun}/{prodi}/{urut}"

# Berapa bulan sebelum SK akreditasi prodi kedaluwarsa layar master prodi dan
# dasbor staf mulai memperingatkan. Lulusan yang lulus saat akreditasi tidak
# berlaku tidak mendapat nomor PISN, tanpa eksepsi (ADR-041 §3).
ACADEMIC_AKREDITASI_PERINGATAN_BULAN=6

#--------------------------------------------------------------------------
# EDOM (evaluasi dosen oleh mahasiswa)
#--------------------------------------------------------------------------
# EDOM_GERBANG: "nonaktif" | "krs" | "khs".
# Tanpa gerbang, pengisian tinggal belasan persen dan hasilnya condong ke yang
# paling puas dan yang paling marah. Bawaannya "krs" — menahan pengajuan KRS
# semester berikutnya menahan tindakan yang belum terjadi, sedangkan "khs"
# menahan nilai yang sudah diperoleh mahasiswa sebagai alat tukar. Praktik "khs"
# lazim di Indonesia dan tetap disediakan; pilih dengan sadar.
EDOM_GERBANG=krs

# EDOM_KOMENTAR: "prodi" | "dosen" | "tutup".
# Skor dapat dirata-ratakan sampai tak seorang pun dapat dikenali; kalimat tidak.
# Bawaannya "prodi": komentar dibaca pengelola program studi, bukan dosen yang
# dinilai.
EDOM_KOMENTAR=prodi

#--------------------------------------------------------------------------
# Integrasi akuntansi — Easy Accounting (easyERP)
#--------------------------------------------------------------------------
# Integrasi ini OPSIONAL dan mati sampai dinyalakan. Banyak kampus memegang
# buku besarnya di tempat lain, dan mereka tidak menanggung apa pun dari modul
# ini: tanpa baris outbox, tanpa menu, tanpa proses terjadwal.
#
#   nonaktif  tidak ada yang dicatat (bawaan)
#   palsu     dokumen diantre & dapat diekspor, tetapi tidak dikirim
#   easyerp   terhubung sungguhan
#
# Penagihan di Open Academic berjalan sama persis pada ketiga pilihan.
AKUNTANSI_DRIVER=nonaktif
AKUNTANSI_BASE_URL=http://localhost/easyerp/public/api/v1
AKUNTANSI_API_KEY=

# Kode akun HARUS sudah ada di Easy Accounting. Ini penyebab kegagalan
# tersering, dan kebijakan kampus — bukan fakta.
AKUNTANSI_AKUN_KAS=1-1001
AKUNTANSI_AKUN_BANK=1-1002
AKUNTANSI_AKUN_PIUTANG=1-1201
AKUNTANSI_AKUN_PENDAPATAN=4-1001
AKUNTANSI_AKUN_BEASISWA=6-1101

# "bruto": pendapatan diakui penuh, potongan jadi Beban Beasiswa — sehingga
# terlihat berapa yang kampus keluarkan. "netto": invoice sebesar yang ditagih,
# dan angka beasiswa lenyap dari laporan.
AKUNTANSI_PERLAKUAN_BEASISWA=bruto

# Jasa pendidikan dikecualikan dari PPN. Nyalakan hanya bila kampus menagih
# komponen kena pajak lewat badan hukum yang sama — dan pastikan akun
# "PPN Keluaran" sudah ada di seberang.
AKUNTANSI_KENA_PPN=false
AKUNTANSI_CSV_BOM=true

#--------------------------------------------------------------------------
# BKD (beban kerja dosen) & portofolio SISTER
#--------------------------------------------------------------------------
# BKD_WAJIB: "serdos" | "semua".
# BKD adalah syarat tunjangan sertifikasi, jadi bawaannya hanya pemegang
# Sertifikat Pendidik yang diminta melapor. "semua" membebankan administrasi
# yang tidak diminta regulasi — pilih sadar.
BKD_WAJIB=serdos

# Rentang beban per semester, dalam perseratus SKS (1200 = 12,00).
# Integer, bukan desimal: angkanya dijumlahkan dari belasan baris lalu
# dibandingkan dengan ambang yang menentukan dibayar atau tidaknya tunjangan.
BKD_MIN_SKS_RATUS=1200
BKD_MAKS_SKS_RATUS=1600
BKD_MIN_PENDIDIKAN_RATUS=900
BKD_MIN_PENELITIAN_RATUS=300

# Rubrik ekuivalensi SKS — kebijakan kampus, bukan fakta. Selengkapnya di
# config/bkd.php; yang di bawah hanya yang paling sering diubah.
BKD_MENGAJAR_BAGI_RATA=true
BKD_BIMBINGAN_UTAMA_RATUS=100
BKD_BIMBINGAN_PENDAMPING_RATUS=50
BKD_MENGUJI_RATUS=25
BKD_PERWALIAN_RATUS=100

# Excel di Windows berbahasa Indonesia membaca CSV UTF-8 tanpa BOM sebagai
# mojibake. BOM-nya jelek; nama bergelar yang tampil rusak lebih jelek.
BKD_CSV_BOM=true

#--------------------------------------------------------------------------
# Buku besar angka kredit (Kum A–E)
#--------------------------------------------------------------------------
# Buku besar, bukan penilaian — PAK dinilai di platform kementerian.
# Semua dalam perseratus. Selengkapnya di config/angka_kredit.php.
#
# Kinerja yang mulai sebelum tanggal ini dikonversi SKS BKD × 4. Sesudahnya
# faktor kampus dipakai sebagai PERKIRAAN, karena klaimnya langsung dari LKD.
ANGKA_KREDIT_KONVERSI_SEBELUM=2026-01-01
ANGKA_KREDIT_FAKTOR_KONVERSI_RATUS=400
ANGKA_KREDIT_FAKTOR_SESUDAH_RATUS=400

# Kum A per ijazah sesudah TMT jabatan berlaku.
ANGKA_KREDIT_MAGISTER_RATUS=15000
ANGKA_KREDIT_DOKTOR_RATUS=20000

# Kum D dan E masing-masing paling banyak sekian persen dari total DUPAK.
ANGKA_KREDIT_BATAS_PENGABDIAN_PERSEN=10
ANGKA_KREDIT_BATAS_PENUNJANG_PERSEN=10

# Syarat jenjang berikutnya: AK kumulatif dan bagian minimum Kum C dari AK
# yang masih dibutuhkan. Tafsir pedoman — periksa terhadap pedoman kampus.
ANGKA_KREDIT_SYARAT_AA_RATUS=15000
ANGKA_KREDIT_SYARAT_L_RATUS=20000
ANGKA_KREDIT_SYARAT_LK_RATUS=55000
ANGKA_KREDIT_SYARAT_GB_RATUS=85000
ANGKA_KREDIT_PENELITIAN_AA_PERSEN=0
ANGKA_KREDIT_PENELITIAN_L_PERSEN=35
ANGKA_KREDIT_PENELITIAN_LK_PERSEN=40
ANGKA_KREDIT_PENELITIAN_GB_PERSEN=45

# Lembar AK penyetaraan: dosen tetap AA/L/LK dengan TMT paling lambat ini.
ANGKA_KREDIT_PENYETARAAN_TMT=2023-12-31

#--------------------------------------------------------------------------
# PDDIKTI Neo Feeder
#--------------------------------------------------------------------------
# Kode skema beasiswa yang merupakan KIP Kuliah, dipisah koma. Kosong berarti
# laporan semester Puslapdik menolak dibuat — dan layarnya mengatakan sebabnya,
# alih-alih menghasilkan berkas nol penerima yang terbaca sebagai fakta.
KIPK_BEASISWA_KODE=

# Mewajibkan seluruh staf memasang verifikasi dua langkah. Bawaannya false agar
# pemasangan yang sudah berjalan tidak mengunci seluruh stafnya pada hari mereka
# menarik pembaruan. Nyalakan sesudah stafnya didampingi memasang — lihat
# SECURITY.md.
DUA_FAKTOR_WAJIB=false

FEEDER_ENABLED=false
FEEDER_DRIVER=fake
FEEDER_BASE_URL=http://localhost:3003/ws/live2.php
FEEDER_USERNAME=
FEEDER_PASSWORD=
FEEDER_TOKEN_TTL=3600
FEEDER_TIMEOUT=60

#--------------------------------------------------------------------------
# Campus Bridge (integration with Open Campus / third parties)
#--------------------------------------------------------------------------
BRIDGE_ENABLED=true
BRIDGE_WEBHOOK_SECRET=
BRIDGE_WEBHOOK_TIMEOUT=15
BRIDGE_WEBHOOK_MAX_ATTEMPTS=5

#--------------------------------------------------------------------------
# SSO (Open Academic sebagai penyedia identitas OAuth2)
#--------------------------------------------------------------------------
# Nonaktif secara bawaan. Aktifkan hanya bila ada aplikasi kampus lain yang
# akan memakai akun Open Academic untuk masuk. Setelah SSO_ENABLED=true,
# jalankan: php artisan passport:keys
SSO_ENABLED=false
SSO_ACCESS_TOKEN_MINUTES=60
SSO_REFRESH_TOKEN_MINUTES=43200

# Client id aplikasi yang boleh melewati layar persetujuan, dipisah koma.
# Isi HANYA dengan aplikasi milik kampus sendiri — ini menghapus satu-satunya
# titik di mana mahasiswa bisa menolak.
SSO_FIRST_PARTY=

# Populasi yang boleh memakai SSO. Persempit bila kebijakan untuk staf belum
# selesai, misalnya: SSO_ALLOWED_ROLES=mahasiswa,dosen
SSO_ALLOWED_ROLES=mahasiswa,dosen,staff

#--------------------------------------------------------------------------
# Denda keterlambatan pembayaran
#--------------------------------------------------------------------------
#
# Mati secara bawaan — ini kebijakan kampus, bukan fakta. Bekerja penuh pada
# pembayaran manual yang dicatat kasir; tidak memerlukan payment gateway.
#
# PAYMENT_DENDA_BENTUK   nominal : PAYMENT_DENDA_NOMINAL rupiah per periode
#                        persen  : PAYMENT_DENDA_PERSEN % dari sisa tagihan
#                                  pokok per periode, dibulatkan ke bawah
# PAYMENT_DENDA_PERIODE  hari | minggu (minggu yang baru berjalan dihitung penuh)
# PAYMENT_DENDA_MAKSIMUM batas denda kumulatif per tagihan; 0 = tanpa batas
# PAYMENT_DENDA_TENGGANG_HARI hari sesudah jatuh tempo yang masih bebas denda
#
# Dihitung harian oleh `openacademic:hitung-denda` lewat penjadwal (cron di
# atas). Sebelum menyalakannya, jalankan `php artisan openacademic:hitung-denda
# --kering` untuk melihat siapa yang akan terkena dan berapa: tagihan yang
# sudah lama menunggak dikenai sejak jatuh temponya. Denda tidak mengubah
# syarat pembayaran KRS — ambangnya dihitung dari tagihan pokok.

PAYMENT_DENDA_AKTIF=false
PAYMENT_DENDA_BENTUK=nominal
PAYMENT_DENDA_PERIODE=hari
PAYMENT_DENDA_NOMINAL=10000
PAYMENT_DENDA_PERSEN=1
PAYMENT_DENDA_MAKSIMUM=500000
PAYMENT_DENDA_TENGGANG_HARI=0

# Tagihan dari KRS — tarif per SKS dan per mata kuliah (ADR-030)
# Komponen per_sks/mata_kuliah ditagih saat Dosen Wali menyetujui KRS.
# PAYMENT_KRS_JATUH_TEMPO_HARI   hari sesudah persetujuan; tidak memajukan
#                                jatuh tempo tagihan yang sudah lebih lambat
# PAYMENT_KRS_BATAS_PENGURANGAN  krs_selesai | krs_perubahan_selesai | tidak_pernah
#                                sampai kapan kelas yang dibatalkan saat revisi
#                                KRS masih mengurangi tagihan
PAYMENT_KRS_JATUH_TEMPO_HARI=14
PAYMENT_KRS_BATAS_PENGURANGAN=krs_selesai

#--------------------------------------------------------------------------
# Masuk lewat IdP kampus (Open Academic sebagai KONSUMEN identitas, OIDC)
#--------------------------------------------------------------------------
# Kebalikan blok SSO di atas. Nonaktif secara bawaan; saat aktif, halaman masuk
# mendapat tombol "Masuk dengan <IDP_NAME>" dan rute /masuk/idp terdaftar.
#
# IDP_DRIVER: fake (uji/demo, tanpa jaringan) | oidc.
# IDP_ISSUER harus HTTPS dan sama persis dengan klaim `iss` pada ID token:
#   Google    https://accounts.google.com
#   Entra ID  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak  https://sso.kampus.ac.id/realms/kampus
# Redirect URI yang didaftarkan di IdP: <APP_URL>/masuk/idp/callback
#
# IDP_GUARDS: staff (bawaan) atau staff,dosen. Mahasiswa tidak dapat dipilih.
# IDP_PROVISION=false: surel yang tidak ada di tabel ditolak (bawaan).
# IDP_PROVISION_DOMAINS: domain surel yang boleh dibuatkan akun saat
#   IDP_PROVISION=true, dipisah koma (kampus.ac.id). Kosong = tidak ada.
# IDP_REQUIRE_VERIFIED_EMAIL=false hanya bila IdP tidak mengirim email_verified
#   (Entra ID untuk anggota tenant).
# IDP_SATISFIES_2FA=true hanya bila IdP sendiri memaksakan faktor kedua untuk
#   seluruh staf; selain itu TOTP lokal tetap ditantang. Lihat docs/SSO.md.
IDP_ENABLED=false
IDP_DRIVER=fake
IDP_NAME="Akun Kampus"
IDP_ISSUER=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_SCOPES="openid email profile"
IDP_GUARDS=staff
IDP_PROVISION=false
IDP_PROVISION_DOMAINS=
IDP_REQUIRE_VERIFIED_EMAIL=true
IDP_SATISFIES_2FA=false

#--------------------------------------------------------------------------
# PMB daring — portal calon mahasiswa (docs/PMB.md)
#--------------------------------------------------------------------------
# Kelulusan otomatis berdasarkan ambang per prodi sesudah impor nilai seleksi.
# Bawaan mati: kelulusan diputuskan staf, dan menyalakannya tetap tidak
# mengumumkan apa pun. Batas laju melindungi halaman publik /pmb.
PMB_KELULUSAN_OTOMATIS=false
PMB_BATAS_DAFTAR_PER_JAM=10
PMB_BATAS_MASUK=5
PMB_BATAS_SUREL_PER_MENIT=3
PMB_IMPOR_MAKS_BARIS=5000

#--------------------------------------------------------------------------
# KKN / PKL — kegiatan lapangan terkelola (#37)
#--------------------------------------------------------------------------
# Bawaan untuk periode baru; setiap periode menyimpan salinannya sendiri.
# MIN_SKS 0 = tanpa batas. BOBOT_MITRA adalah persen nilai akhir dari
# pembimbing mitra; sisanya dari dosen pembimbing lapangan.
KEGIATAN_LAPANGAN_MIN_SKS=0
KEGIATAN_LAPANGAN_UKURAN_KELOMPOK=10
KEGIATAN_LAPANGAN_CAMPUR_PRODI=true
KEGIATAN_LAPANGAN_CAMPUR_JENIS_KELAMIN=true
KEGIATAN_LAPANGAN_BOBOT_MITRA=40

#--------------------------------------------------------------------------
# Pemakaian ruang — laporan pemanfaatan (#42)
#--------------------------------------------------------------------------
# Penyebut setiap persentase: hari (ISO, 1 = Senin ... 7 = Minggu) dan jam
# ruang dapat dipakai. Pemakaian di luarnya dilaporkan terpisah. Libur kampus
# dari kalender akademik tidak dihitung sebagai jam tersedia. AMBANG_JARANG
# dalam persen; LANGKAH_PETA lebar satu kolom peta panas dalam menit.
RUANG_HARI_OPERASIONAL=1,2,3,4,5
RUANG_JAM_MULAI=07:00
RUANG_JAM_SELESAI=17:00
RUANG_AMBANG_JARANG=25
RUANG_LANGKAH_PETA=60
RUANG_CSV_BOM=true

#--------------------------------------------------------------------------
# Lulusan & tracer study (ADR-037 §2)
#--------------------------------------------------------------------------
# Berapa bulan kontak lulusan yang sudah diverifikasi staf dianggap masih
# berlaku. Lewat dari itu, barisnya kembali ditandai perlu verifikasi.
KEMAHASISWAAN_LULUSAN_VERIFIKASI_BULAN=12

#--------------------------------------------------------------------------
# Payment gateway — BELUM ADA, jadi tidak ada variabelnya
#--------------------------------------------------------------------------
# Blok ini dulu berisi PAYMENT_GATEWAY dan empat variabel MIDTRANS_*. Tidak
# satu pun pernah dibaca kode: tidak ada kelas driver, tidak ada binding.
# Mengisinya tidak menyalakan apa pun — dan itu jebakan yang mahal, karena
# kunci merchant sungguhan berakhir di berkas produksi demi integrasi yang
