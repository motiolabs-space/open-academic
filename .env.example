APP_NAME="Open Academic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Mesin basis data adalah pilihan konfigurasi, bukan keputusan yang tertanam di
# kode: seluruh akses data lewat Eloquent. Ganti ke PostgreSQL cukup dengan
# DB_CONNECTION=pgsql dan DB_PORT=5432.
#
# Didukung: mysql · pgsql · sqlite. Oracle butuh paket pihak ketiga —
# baca docs/BASIS-DATA.md sebelum merencanakannya.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=open_academic
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Set SESSION_SECURE_COOKIE=true on any installation served over HTTPS —
# without it the session cookie is sent over plain HTTP too, which is all an
# attacker on the same campus wifi needs to take over a staff account.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@open-academic.test"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Notifikasi
#--------------------------------------------------------------------------
#
# Notifikasi memerlukan worker antrean yang menyala:
#
#   php artisan queue:work --tries=3
#
# dan pengingat tenggat memerlukan satu entri cron:
#
#   * * * * * cd /path/ke/aplikasi && php artisan schedule:run >> /dev/null 2>&1
#
# Tanpa keduanya tidak ada yang terkirim, dan tidak ada yang memberi tahu bahwa
# demikian. Lihat docs/NOTIFIKASI.md.
#
# WhatsApp mati secara bawaan dan tidak menyertakan adaptor penyedia mana pun.
# Menyalakannya perlu dua hal terpisah: driver, dan daftar kategori yang boleh
# lewat. Nama driver yang tidak dikenal akan menggagalkan boot — bukan diam-diam
# berhenti mengirim.

NOTIFIKASI_WHATSAPP_DRIVER=nonaktif
NOTIFIKASI_WHATSAPP_PENGIRIM=
NOTIFIKASI_WHATSAPP_KATEGORI=

#--------------------------------------------------------------------------
# Surat & Verifikasi Dokumen
#--------------------------------------------------------------------------
#
# TETAPKAN POLA NOMOR SEBELUM SURAT PERTAMA TERBIT. Mengubahnya setelah itu
# berarti dua konvensi hidup berdampingan di lemari arsip yang sama.
#
# Placeholder: {urut} {kode} {bulan} (Romawi) {tahun} {institusi}
#
# Nama penandatangan boleh dikosongkan — yang tercetak lalu hanya nama
# institusi, dan itu lebih baik daripada nama pejabat yang sudah tidak
# menjabat.
#
# SURAT_TAHAN_BILA_MENUNGGAK hanya menghitung tagihan yang SUDAH LEWAT jatuh
# tempo. Lihat docs/SURAT.md.

SURAT_POLA_NOMOR="{urut}/{kode}/{institusi}/{bulan}/{tahun}"
SURAT_PENANDATANGAN_NAMA=
SURAT_PENANDATANGAN_JABATAN="Kepala Biro Administrasi Akademik"
SURAT_PENANDATANGAN_NIP=
SURAT_TAHAN_BILA_MENUNGGAK=false
SURAT_VERIFIKASI_AKTIF=true
SURAT_VERIFIKASI_BATAS=10

#--------------------------------------------------------------------------
# Konversi Kredit (Transfer & RPL)
#--------------------------------------------------------------------------
#
# ACADEMIC_KONVERSI_HITUNG_IPK — apakah nilai yang dikonversi ikut menghitung
# IPK. Mati secara bawaan, dan itu posisi bukan ketidakpedulian: IPK adalah
# penilaian institusi ini, sedangkan nilai konversi diberikan pihak lain dengan
# standar lain. Kreditnya selalu masuk total SKS apa pun setelannya.
#
# ACADEMIC_KONVERSI_MAKS_PERSEN — batas pengakuan terhadap syarat kelulusan
# prodi. Tanpa batas, seseorang dapat diakui masuk ke dalam gelar. Tetapkan
# angkanya secara sadar.

ACADEMIC_KONVERSI_HITUNG_IPK=false
ACADEMIC_KONVERSI_MAKS_PERSEN=50

#--------------------------------------------------------------------------
# Keringanan & Beasiswa
#--------------------------------------------------------------------------
#
# Tidak ada setelan environment. Skema beasiswa, cakupan, dan kuotanya dibuat
# lewat layar Beasiswa & Keringanan — itu keputusan kampus, bukan konfigurasi
# deployment.
#
# Yang perlu diketahui operator: potongan adalah baris bernilai negatif pada
# tagihan, sehingga tagihan.total selalu sama dengan jumlah barisnya dan selalu
# merupakan jumlah yang benar-benar harus dibayar. Jangan menambahkan potongan
# lewat SQL langsung tanpa menghitung ulang total dan status pembayarannya.

#--------------------------------------------------------------------------
# Institution branding (per-tenant white label)
#--------------------------------------------------------------------------
BRAND_INSTITUTION_NAME="Universitas Nusantara Digital"
BRAND_INSTITUTION_SHORT="UND"
BRAND_INSTITUTION_CODE="001001"
BRAND_LOGO_PATH=
BRAND_PRIMARY_COLOR="#1E2761"
BRAND_ACCENT_COLOR="#C9A961"

#--------------------------------------------------------------------------
# Academic defaults
#--------------------------------------------------------------------------
ACADEMIC_ACTIVE_TERM=20261
ACADEMIC_MEETINGS_PER_TERM=16
ACADEMIC_MIN_ATTENDANCE_PERCENT=75
ACADEMIC_KRS_REQUIRES_PAYMENT=true
ACADEMIC_KRS_MIN_PAYMENT_PERCENT=50

#--------------------------------------------------------------------------
# EDOM (evaluasi dosen oleh mahasiswa)
#--------------------------------------------------------------------------
# EDOM_GERBANG: "nonaktif" | "krs" | "khs".
# Tanpa gerbang, pengisian tinggal belasan persen dan hasilnya condong ke yang
# paling puas dan yang paling marah. Bawaannya "krs" — menahan pengajuan KRS
# semester berikutnya menahan tindakan yang belum terjadi, sedangkan "khs"
# menahan nilai yang sudah diperoleh mahasiswa sebagai alat tukar. Praktik "khs"
# lazim di Indonesia dan tetap disediakan; pilih dengan sadar.
EDOM_GERBANG=krs

# EDOM_KOMENTAR: "prodi" | "dosen" | "tutup".
# Skor dapat dirata-ratakan sampai tak seorang pun dapat dikenali; kalimat tidak.
# Bawaannya "prodi": komentar dibaca pengelola program studi, bukan dosen yang
# dinilai.
EDOM_KOMENTAR=prodi

#--------------------------------------------------------------------------
# Integrasi akuntansi — Easy Accounting (easyERP)
#--------------------------------------------------------------------------
# Integrasi ini OPSIONAL dan mati sampai dinyalakan. Banyak kampus memegang
# buku besarnya di tempat lain, dan mereka tidak menanggung apa pun dari modul
# ini: tanpa baris outbox, tanpa menu, tanpa proses terjadwal.
#
#   nonaktif  tidak ada yang dicatat (bawaan)
#   palsu     dokumen diantre & dapat diekspor, tetapi tidak dikirim
#   easyerp   terhubung sungguhan
#
# Penagihan di Open Academic berjalan sama persis pada ketiga pilihan.
AKUNTANSI_DRIVER=nonaktif
AKUNTANSI_BASE_URL=http://localhost/easyerp/public/api/v1
AKUNTANSI_API_KEY=

# Kode akun HARUS sudah ada di Easy Accounting. Ini penyebab kegagalan
# tersering, dan kebijakan kampus — bukan fakta.
AKUNTANSI_AKUN_KAS=1-1001
AKUNTANSI_AKUN_BANK=1-1002
AKUNTANSI_AKUN_PIUTANG=1-1201
AKUNTANSI_AKUN_PENDAPATAN=4-1001
AKUNTANSI_AKUN_BEASISWA=6-1101

# "bruto": pendapatan diakui penuh, potongan jadi Beban Beasiswa — sehingga
# terlihat berapa yang kampus keluarkan. "netto": invoice sebesar yang ditagih,
# dan angka beasiswa lenyap dari laporan.
AKUNTANSI_PERLAKUAN_BEASISWA=bruto

# Jasa pendidikan dikecualikan dari PPN. Nyalakan hanya bila kampus menagih
# komponen kena pajak lewat badan hukum yang sama — dan pastikan akun
# "PPN Keluaran" sudah ada di seberang.
AKUNTANSI_KENA_PPN=false
AKUNTANSI_CSV_BOM=true

#--------------------------------------------------------------------------
# BKD (beban kerja dosen) & portofolio SISTER
#--------------------------------------------------------------------------
# BKD_WAJIB: "serdos" | "semua".
# BKD adalah syarat tunjangan sertifikasi, jadi bawaannya hanya pemegang
# Sertifikat Pendidik yang diminta melapor. "semua" membebankan administrasi
# yang tidak diminta regulasi — pilih sadar.
BKD_WAJIB=serdos

# Rentang beban per semester, dalam perseratus SKS (1200 = 12,00).
# Integer, bukan desimal: angkanya dijumlahkan dari belasan baris lalu
# dibandingkan dengan ambang yang menentukan dibayar atau tidaknya tunjangan.
BKD_MIN_SKS_RATUS=1200
BKD_MAKS_SKS_RATUS=1600
BKD_MIN_PENDIDIKAN_RATUS=900
BKD_MIN_PENELITIAN_RATUS=300

# Rubrik ekuivalensi SKS — kebijakan kampus, bukan fakta. Selengkapnya di
# config/bkd.php; yang di bawah hanya yang paling sering diubah.
BKD_MENGAJAR_BAGI_RATA=true
BKD_BIMBINGAN_UTAMA_RATUS=100
BKD_BIMBINGAN_PENDAMPING_RATUS=50
BKD_MENGUJI_RATUS=25
BKD_PERWALIAN_RATUS=100

# Excel di Windows berbahasa Indonesia membaca CSV UTF-8 tanpa BOM sebagai
# mojibake. BOM-nya jelek; nama bergelar yang tampil rusak lebih jelek.
BKD_CSV_BOM=true

#--------------------------------------------------------------------------
# PDDIKTI Neo Feeder
#--------------------------------------------------------------------------
FEEDER_ENABLED=false
FEEDER_DRIVER=fake
FEEDER_BASE_URL=http://localhost:3003/ws/live2.php
FEEDER_USERNAME=
FEEDER_PASSWORD=
FEEDER_TOKEN_TTL=3600
FEEDER_TIMEOUT=60

#--------------------------------------------------------------------------
# Campus Bridge (integration with Open Campus / third parties)
#--------------------------------------------------------------------------
BRIDGE_ENABLED=true
BRIDGE_WEBHOOK_SECRET=
BRIDGE_WEBHOOK_TIMEOUT=15
BRIDGE_WEBHOOK_MAX_ATTEMPTS=5

#--------------------------------------------------------------------------
# SSO (Open Academic sebagai penyedia identitas OAuth2)
#--------------------------------------------------------------------------
# Nonaktif secara bawaan. Aktifkan hanya bila ada aplikasi kampus lain yang
# akan memakai akun Open Academic untuk masuk. Setelah SSO_ENABLED=true,
# jalankan: php artisan passport:keys
SSO_ENABLED=false
SSO_ACCESS_TOKEN_MINUTES=60
SSO_REFRESH_TOKEN_MINUTES=43200

# Client id aplikasi yang boleh melewati layar persetujuan, dipisah koma.
# Isi HANYA dengan aplikasi milik kampus sendiri — ini menghapus satu-satunya
# titik di mana mahasiswa bisa menolak.
SSO_FIRST_PARTY=

# Populasi yang boleh memakai SSO. Persempit bila kebijakan untuk staf belum
# selesai, misalnya: SSO_ALLOWED_ROLES=mahasiswa,dosen
SSO_ALLOWED_ROLES=mahasiswa,dosen,staff

#--------------------------------------------------------------------------
# Payment gateway (Midtrans)
#--------------------------------------------------------------------------
PAYMENT_GATEWAY=fake
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

VITE_APP_NAME="${APP_NAME}"
