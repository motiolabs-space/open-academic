{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "not_operator_with_successor_space": false,
        "concat_space": {
            "spacing": "none"
        },
        "nullable_type_declaration_for_default_null_value": true,
        "phpdoc_align": {
            "align": "left"
        }
    },
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor"
    ]
}
